#version 450
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0,rgba8) uniform writeonly image2D target;
layout(push_constant) uniform Settings { uint frame; } p;
void main() {
    ivec2 id=ivec2(gl_GlobalInvocationID.xy);
    uvec2 size=uvec2(imageSize(target));
    if(any(greaterThanEqual(uvec2(id),size))) return;
    uint u=(uint(id.x)+size.x-p.frame%size.x)%size.x;
    uint c=((u/12u+uint(id.y)/12u)&1u)!=0u?190u:35u;
    uvec4 rgb=uvec4(c,u%80u<3u?240u:c,uint(id.y)%53u<2u?230u:c,255u);
    imageStore(target,id,vec4(rgb)/255.0);
}
