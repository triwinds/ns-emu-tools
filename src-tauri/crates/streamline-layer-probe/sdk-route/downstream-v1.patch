@@ -0,0 +1,30 @@
+#pragma once
+// Experimental private ABI; official VulkanInfo and VkTable layouts are unchanged.
+#include <cstdint>
+#include "external/vulkan/include/vulkan/vulkan.h"
+#include "include/sl_result.h"
+
+struct SlLayerRouteV1
+{
+    uint32_t size;
+    uint32_t version;
+    VkInstance instance;
+    VkPhysicalDevice physicalDevice;
+    VkDevice device;
+    PFN_vkGetInstanceProcAddr getInstanceProcAddr;
+    PFN_vkGetDeviceProcAddr getDeviceProcAddr;
+};
+static_assert(sizeof(SlLayerRouteV1) == 48, "This experiment requires Windows x64");
+
+// Host serializes registration, slSetVulkanInfo and shutdown. Callback code and
+// native objects must outlive all SDK work and successful slShutdown.
+extern "C" sl::Result slRegisterVulkanLayerRouteV1(const SlLayerRouteV1* route);
+
+namespace sl::layer_route
+{
+sl::Result bind(const SlLayerRouteV1* route);
+sl::Result claim(VkInstance instance, VkPhysicalDevice physical, VkDevice device);
+void clear();
+PFN_vkVoidFunction VKAPI_CALL instanceProc(VkInstance instance, const char* name);
+PFN_vkVoidFunction VKAPI_CALL deviceProc(VkDevice device, const char* name);
+}
