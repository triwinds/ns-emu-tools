diff --git a/source/core/sl.interposer/vulkan/layerRoute.cpp b/source/core/sl.interposer/vulkan/layerRoute.cpp
new file mode 100644
index 0000000..149ed05
--- /dev/null
+++ b/source/core/sl.interposer/vulkan/layerRoute.cpp
@@ -0,0 +1,75 @@
+#include "layerRoute.h"
+#include <cstring>
+#include <mutex>
+
+namespace sl::layer_route
+{
+namespace
+{
+std::mutex mutex;
+SlLayerRouteV1 binding{};
+bool claimed = false;
+}
+
+sl::Result bind(const SlLayerRouteV1* route)
+{
+    if (!route || route->size != sizeof(SlLayerRouteV1) || route->version != 1 ||
+        !route->instance || !route->physicalDevice || !route->device ||
+        !route->getInstanceProcAddr || !route->getDeviceProcAddr ||
+        route->getInstanceProcAddr == instanceProc || route->getDeviceProcAddr == deviceProc)
+        return sl::Result::eErrorInvalidParameter;
+    std::lock_guard<std::mutex> lock(mutex);
+    if (binding.device)
+        return sl::Result::eErrorInvalidState;
+    binding = *route;
+    return sl::Result::eOk;
+}
+
+sl::Result claim(VkInstance instance, VkPhysicalDevice physical, VkDevice device)
+{
+    std::lock_guard<std::mutex> lock(mutex);
+    if (!binding.device || claimed || binding.instance != instance ||
+        binding.physicalDevice != physical || binding.device != device)
+        return sl::Result::eErrorInvalidState;
+    claimed = true;
+    return sl::Result::eOk;
+}
+
+void clear()
+{
+    // Only after plugin teardown; this does not wait for host-owned work.
+    std::lock_guard<std::mutex> lock(mutex);
+    binding = {};
+    claimed = false;
+}
+
+PFN_vkVoidFunction VKAPI_CALL instanceProc(VkInstance instance, const char* name)
+{
+    PFN_vkGetInstanceProcAddr next{};
+    {
+        std::lock_guard<std::mutex> lock(mutex);
+        if (!claimed || !name || !instance || instance != binding.instance)
+            return nullptr;
+        next = binding.getInstanceProcAddr;
+    }
+    if (std::strcmp(name, "vkGetInstanceProcAddr") == 0)
+        return reinterpret_cast<PFN_vkVoidFunction>(instanceProc);
+    if (std::strcmp(name, "vkGetDeviceProcAddr") == 0)
+        return reinterpret_cast<PFN_vkVoidFunction>(deviceProc);
+    return next(instance, name); // Do not hold the lock across downstream calls.
+}
+
+PFN_vkVoidFunction VKAPI_CALL deviceProc(VkDevice device, const char* name)
+{
+    PFN_vkGetDeviceProcAddr next{};
+    {
+        std::lock_guard<std::mutex> lock(mutex);
+        if (!claimed || !name || !device || device != binding.device)
+            return nullptr;
+        next = binding.getDeviceProcAddr;
+    }
+    if (std::strcmp(name, "vkGetDeviceProcAddr") == 0)
+        return reinterpret_cast<PFN_vkVoidFunction>(deviceProc);
+    return next(device, name);
+}
+}
