#version 450
#extension GL_GOOGLE_include_directive : require
#include "nr_look_common.glsl"
// Per-texel composition; optional neighbourhood data comes from a prior
// read-only NR band dispatch, never from concurrently modified output.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba16f) uniform readonly image2D original;
layout(set = 0, binding = 1, rgba16f) uniform image2D rendered;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D band;
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D temporal_delta;
layout(set = 0, binding = 4, rgba16f) uniform readonly image2D guide;
layout(set = 0, binding = 5, rgba16f) uniform readonly image2D first_pass;
layout(set = 0, binding = 6, rgba16f) uniform readonly image2D raw_model;
layout(push_constant) uniform Controls {
    vec4 gains; // amount, brighten, darken, brighten cap (stops)
    vec4 chroma; // darken cap, color, hue, shadows
    vec4 zones; // midtones, highlights, spatial active, temporal active
    vec4 spatial; // lighting, detail, radius (working pixels), halo
    vec4 protection; // hue, shadows, highlights, overcorrection
    vec4 experiments; // Oklab enabled, diagnostic code, reserved
} controls;
vec3 to_oklab(vec3 c) {
    vec3 lms=vec3(dot(c,vec3(0.4122214708,0.5363325363,0.0514459929)),
        dot(c,vec3(0.2119034982,0.6806995451,0.1073969566)),
        dot(c,vec3(0.0883024619,0.2817188376,0.6299787005)));
    lms=pow(max(lms,vec3(0)),vec3(1.0/3.0));
    return vec3(dot(lms,vec3(0.2104542553,0.7936177850,-0.0040720468)),
        dot(lms,vec3(1.9779984951,-2.4285922050,0.4505937099)),
        dot(lms,vec3(0.0259040371,0.7827717662,-0.8086757660)));
}
vec3 from_oklab(vec3 lab) {
    vec3 lms=vec3(lab.x+0.3963377774*lab.y+0.2158037573*lab.z,
        lab.x-0.1055613458*lab.y-0.0638541728*lab.z,
        lab.x-0.0894841775*lab.y-1.2914855480*lab.z);
    lms=lms*lms*lms;
    return vec3(dot(lms,vec3(4.0767416621,-3.3077115913,0.2309699292)),
        dot(lms,vec3(-1.2684380046,2.6097574011,-0.3413193965)),
        dot(lms,vec3(-0.0041960863,-0.7034186147,1.7076147010)));
}
vec3 delta_view(vec3 e) { return clamp(vec3(0.5)+e*0.125,0,1); }
vec3 encode(vec3 c) {
    vec3 result = mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, greaterThan(c, vec3(0.0031308)));
    return mix(result, vec3(1.0), greaterThanEqual(c, vec3(1.0)));
}
float limit_change(float e, float cap) {
    return cap > 0.0 ? cap * tanh(e / cap) : e;
}
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(original)))) return;
    vec4 p = imageLoad(original, pixel);
    vec4 n = imageLoad(rendered, pixel);
    int diagnostic=int(controls.experiments.y+0.5);
    if(diagnostic>=1 && diagnostic<=3) {
        vec3 rgb=diagnostic==1?imageLoad(guide,pixel).rgb:
            diagnostic==2?imageLoad(first_pass,pixel).rgb:imageLoad(raw_model,pixel).rgb;
        imageStore(rendered,pixel,vec4(finite_rgb(rgb)?rgb:vec3(0),n.a)); return;
    }
    if(diagnostic==9 || diagnostic==10) {
        vec4 h=controls.zones.w!=0.0?imageLoad(temporal_delta,pixel):vec4(0,0,0,-1);
        float value=diagnostic==9?float(h.a>=0.0 && finite_rgb(h.rgb)):clamp(h.a,0,1);
        imageStore(rendered,pixel,vec4(vec3(value),n.a)); return;
    }
    // Preserve alpha from NR, including when amount=0 selects original RGB.
    if (controls.gains.x == 0.0 && diagnostic==0) {
        imageStore(rendered, pixel, vec4(finite_rgb(p.rgb)?p.rgb:vec3(0), n.a));
        return;
    }
    // Invalid model texels are rejected; never propagate NaNs into composition.
    if (any(isnan(n.rgb)) || any(isinf(n.rgb))) {
        imageStore(rendered, pixel, vec4(finite_rgb(p.rgb)?p.rgb:vec3(0), n.a));
        return;
    }
    // Zero model change is exact, including white and subnormal endpoints.
    if(!finite_rgb(p.rgb)) { imageStore(rendered,pixel,vec4(n.rgb,n.a)); return; }
    if (all(equal(p.rgb, n.rgb)) && controls.zones.w != 2.0 && diagnostic==0) return;
    vec3 P = decode(clamp(p.rgb, 0.0, 1.0));
    vec3 N = decode(clamp(n.rgb, 0.0, 1.0));
    vec3 base = log2(max(P, vec3(1e-6)));
    vec3 e = log2(max(N, vec3(1e-6))) - base;
    vec3 raw_e=e;
    if (controls.zones.w != 0.0) {
        vec4 history = imageLoad(temporal_delta, pixel);
        // Rejected/first-frame history preserves neutral NR output exactly.
        if (diagnostic==0 && all(equal(controls.protection,vec4(0))) && history.a <= 0.0 && all(equal(controls.gains,vec4(1,1,1,0)))
            && all(equal(controls.chroma,vec4(0,1,1,1)))
            && all(equal(controls.zones.xy,vec2(1))) && controls.zones.z == 0.0) return;
        if (history.a > 0.0 && finite_rgb(history.rgb)) e = history.rgb;
    }
    float light = dot(e, LUMA);
    if(diagnostic==4) { imageStore(rendered,pixel,vec4(delta_view(raw_e),n.a)); return; }
    if(diagnostic==6 || diagnostic==7) {
        float low=imageLoad(band,pixel).r;
        imageStore(rendered,pixel,vec4(delta_view(vec3(diagnostic==6?low:light-low)),n.a)); return;
    }
    if (controls.zones.z == 1.0) {
        vec2 bands = imageLoad(band, pixel).rg;
        float detail = light - bands.r;
        if (light < -0.05 && detail < -0.05) {
            // Remove only a negative local residual, never turn a darkening
            // delta into a bright outline when spatial gains are neutral.
            detail += min(-detail, -light) * controls.spatial.w * bands.g;
        }
        light = bands.r * controls.spatial.x + detail * controls.spatial.y;
    }
    float luminance = dot(P, LUMA);
    float shadow = 1.0 - smoothstep(0.02, 0.18, luminance);
    float highlight = smoothstep(0.35, 0.8, luminance);
    float zone = shadow * controls.chroma.w + highlight * controls.zones.y
        + (1.0 - shadow - highlight) * controls.zones.x;
    float region_protection=(1.0-controls.protection.y*shadow)*(1.0-controls.protection.z*highlight);
    float magnitude=max(max(abs(e.r),abs(e.g)),abs(e.b));
    float correction_protection=1.0/(1.0+controls.protection.w*magnitude*magnitude);
    if(diagnostic==8) {
        imageStore(rendered,pixel,vec4(1.0-controls.protection.x,region_protection,correction_protection,n.a)); return;
    }
    float scale = controls.gains.x * zone * region_protection * correction_protection;
    float adjusted_light = light >= 0.0
        ? limit_change(light * controls.gains.y * scale, controls.gains.w)
        : -limit_change(-light * controls.gains.z * scale, controls.chroma.x);
    // Log opponent coordinates: radial change controls color; the perpendicular
    // component controls hue. Hue is undefined for neutral inputs, where all
    // chroma changes use the color gain instead.
    vec2 basis = vec2(base.r - base.g, base.b - base.g);
    vec2 delta = vec2(e.r - e.g, e.b - e.g);
    float length2 = dot(basis, basis);
    vec2 radial = length2 > 1e-4 ? basis * dot(delta, basis) / length2 : delta;
    vec2 adjusted_chroma = (radial * controls.chroma.y + (delta - radial) * controls.chroma.z*(1.0-controls.protection.x)) * scale;
    if(length2>1e-4 && dot(basis,basis+adjusted_chroma)<0.0) {
        adjusted_chroma=mix(adjusted_chroma,-basis*0.9999,controls.protection.x);
    }
    float green = adjusted_light - LUMA.r * adjusted_chroma.x - LUMA.b * adjusted_chroma.y;
    vec3 adjusted = vec3(green + adjusted_chroma.x, green, green + adjusted_chroma.y);
    // Confidence protects near-black ratios, both by pixel and channel. Retain
    // the NR value there rather than amplify epsilon-driven chromatic changes.
    vec3 confidence = smoothstep(vec3(1e-6), vec3(1e-4), P)
        * smoothstep(1e-5, 1e-3, luminance);
    vec3 candidate=P*exp2(clamp(adjusted,-32.0,32.0));
    if(controls.experiments.x!=0.0) {
        // Keep luminance gains/caps in stops. Chroma gains apply to an explicit
        // Oklab radial/perpendicular difference, never reinterpreting RGB units.
        vec3 a=to_oklab(P), b=to_oklab(P*exp2(clamp(e,-32.0,32.0)));
        vec2 change=b.yz-a.yz;
        float norm=dot(a.yz,a.yz);
        vec2 radial_lab=norm>1e-8?a.yz*dot(change,a.yz)/norm:change;
        vec2 chroma_lab=(radial_lab*controls.chroma.y+(change-radial_lab)*controls.chroma.z*(1.0-controls.protection.x))*scale;
        if(norm>1e-8 && dot(a.yz,a.yz+chroma_lab)<0.0) {
            chroma_lab=mix(chroma_lab,-a.yz*0.9999,controls.protection.x);
        }
        candidate=from_oklab(vec3(a.x*exp2(clamp(adjusted_light/3.0,-10.0,10.0)),a.yz+chroma_lab));
        if(!finite_rgb(candidate)) candidate=N;
    }
    vec3 fallback=mix(N,P,1.0-region_protection*correction_protection);
    vec3 result = mix(fallback, candidate, confidence);
    if(diagnostic==5) {
        imageStore(rendered,pixel,vec4(delta_view(log2(max(result,vec3(1e-6)))-base),n.a)); return;
    }
    imageStore(rendered, pixel, vec4(encode(clamp(result, 0.0, 1.0)), n.a));
}
